{
  "name": "@ccjr1120/memory-one",
  "version": "0.1.4",
  "description": "A local HTTP MCP service for personal agent memory",
  "type": "module",
  "bin": {
    "memoryone": "bin/memory-one.mjs"
  },
  "files": [
    "bin",
    "dist/server.js",
    "dist/server.js.map",
    "dist/storage.js",
    "dist/storage.js.map",
    "public",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccjr1120/memory-one.git"
  },
  "homepage": "https://github.com/ccjr1120/memory-one#readme",
  "bugs": "https://github.com/ccjr1120/memory-one/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx src/server.ts",
    "screenshots": "node scripts/capture-screens.mjs",
    "install:local": "bash scripts/install-local.sh",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:web && npm run build:server",
    "test": "tsx --test src/*.test.ts",
    "v": "node scripts/bump-version.mjs",
    "prepublishOnly": "npm test && npm run build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-router": "^1.170.32",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "semver": "^7.8.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
